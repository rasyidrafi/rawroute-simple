{
  "name": "rawroute-simple",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:preview": "bash scripts/dev-preview.sh",
    "preview": "bash scripts/preview.sh",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun build --target=bun --production --outdir=dist ./src/index.ts",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb"
  },
  "dependencies": {
    "spacetimedb": "2.10.*",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun": "^1.3.2",
    "typescript": "^7",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}
