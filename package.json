{
  "name": "rawroute-simple",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "dev:preview": "bash scripts/dev-preview.sh",
    "preview": "bash scripts/preview.sh",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun scripts/build.ts",
    "test:e2e": "bun scripts/e2e.ts",
    "test:e2e:admin": "bun scripts/e2e.ts --admin",
    "test:e2e:accounting": "bun scripts/e2e.ts --admin --accounting",
    "test:e2e:financial": "bun scripts/e2e.ts --admin --accounting --financial",
    "test:e2e:oauth-sharing": "bun scripts/e2e-oauth-sharing.ts",
    "maintenance:usage-ledger": "bun scripts/maintenance.ts --workspace",
    "lint": "oxlint && CI=1 react-doctor --lint --scope full --yes --no-score --blocking error",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@libsql/client": "^0.18.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19",
    "react-router": "^8.4.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.0",
    "@types/bun": "latest",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun": "^1.3.2",
    "oxlint": "^1.85.0",
    "react-doctor": "^0.9.14",
    "typescript": "^7"
  }
}
