# Bun loads .env automatically during development.
# Copy this file to .env and replace the placeholder values.
# Never commit .env or real credentials.

PORT=3001

# Provider-neutral libSQL connection URL.
# Turso Cloud: libsql://<database>-<organization>.turso.io
# Self-hosted libSQL: https://db.example.com
DATABASE_URL=libsql://your-database-your-organization.turso.io

# Required for Turso Cloud. Usually optional for a local or self-hosted server.
# Create one with: turso db tokens create <database-name>
DATABASE_AUTH_TOKEN=replace-with-your-turso-auth-token
