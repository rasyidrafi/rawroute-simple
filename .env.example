# Bun loads .env automatically during development.
# Copy this file to .env and replace the placeholder values.
# Never commit .env or real credentials.

PORT=3001

# The default password used on first startup. There is no public registration route.
# Change these values, especially before production deployment.
AUTH_DEFAULT_PASSWORD=change-me-local

# Optional public origin used for auth origin checks. Set this to the exact
# browser-facing origin in production, for example https://app.example.com.
APP_ORIGIN=

# Keep false for local HTTP. Set true when serving through HTTPS in production.
AUTH_COOKIE_SECURE=false

# Set true only when a trusted reverse proxy overwrites X-Forwarded-For or
# CF-Connecting-IP before forwarding requests to Bun.
TRUST_PROXY_HEADERS=false

# Local development uses a file automatically when DATABASE_URL is omitted.
# You can also set it explicitly:
DATABASE_URL=file:./dev.db

# For Turso Cloud, replace DATABASE_URL and add the token:
# DATABASE_URL=libsql://<database>-<organization>.turso.io
# DATABASE_AUTH_TOKEN=replace-with-your-turso-auth-token
